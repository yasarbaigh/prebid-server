        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "text": {},
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "node_systemd_unit_state{name=\"ssp-track-processor.service\",state=\"active\"}",
          "legendFormat": "Track Status",
          "refId": "A"
        }
      ],
      "title": "Track Processor Status",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "1": { "color": "green", "text": "OK / Active" }, "0": { "color": "red", "text": "FAILED / Inactive" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "id": 4,
      "options": {
        "showValue": "never",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "expr": "max_over_time(node_systemd_unit_state{name=~\"ssp-.*-processor.service\",state=\"active\"}[$__interval])",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Processing Task History (Activity Timeline)",
      "type": "status-history",
      "minInterval": "1m",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "1": { "color": "green", "text": "Processing" }, "0": { "color": "gray", "text": "Idle" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      }
    },
    {
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 13 },
      "id": 5,
      "options": {
        "footer": { "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "expr": "time() - node_systemd_timer_last_trigger_seconds{name=~\"ssp-.*-processor.timer\"}",
          "format": "table",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Time Since Last Trigger (Seconds ago)",
      "type": "table",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
             "mode": "absolute",
             "steps": [
               { "color": "green", "value": null },
               { "color": "orange", "value": 1000 },
               { "color": "red", "value": 2000 }
             ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 6,
      "panels": [],
      "title": "Batch Processing Statistics (Spark)",
      "type": "row"
    },
    {
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 20 },
      "id": 7,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "text": {}
      },
      "targets": [
        {
          "expr": "ssp_log_processor_batch_files_processed",
          "legendFormat": "{{device_name}}",
          "refId": "A"
        }
      ],
      "title": "Files Processed per Batch",
      "type": "gauge",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 20 },
      "id": 8,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum(ssp_log_processor_db_rows_upserted_total) by (table)",
          "legendFormat": "{{table}}",
          "refId": "A"
        }
      ],
      "title": "Rows Upserted into DB (per batch)",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 },
          "unit": "short"
        }
      }
    },
    {
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 20 },
      "id": 9,
      "options": { "showHeader": true },
      "targets": [
        {
          "expr": "time() - ssp_log_processor_last_run_timestamp_seconds",
          "format": "table",
          "legendFormat": "{{device_name}}",
          "refId": "A"
        }
      ],
      "title": "Time Since Last Successful Batch",
      "type": "table",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 600 },
              { "color": "red", "value": 1200 }
            ]
          }
        }
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 37,
  "style": "dark",
