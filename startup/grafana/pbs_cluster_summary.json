      "targets": [{ "expr": "sum(rate(prebid_rtb_ssp_requests_total[1m]))", "refId": "A" }],
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "title": "Median Latency (P50) per Instance", "type": "timeseries", "gridPos": { "h": 6, "w": 16, "x": 8, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.5, sum by (le, device_name) (rate(prebid_rtb_dsp_latency_seconds_bucket[5m])))", "legendFormat": "{{device_name}}" }]
    },
    {
      "title": "SSP Response Status (200 vs Errors)", "type": "piechart", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "targets": [{ "expr": "sum by (status) (rate(prebid_rtb_ssp_responses_total[5m]))", "legendFormat": "{{status}}" }]
    },
    {
      "title": "Exchange Revenue (DSP Spending)", "type": "timeseries", "gridPos": { "h": 8, "w": 16, "x": 8, "y": 6 },
      "targets": [{ "expr": "rate(prebid_rtb_exchange_spent_total[5m])", "legendFormat": "Revenue" }]
    }
