      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(irate(vector_events_in_total{device_name=~\"$device_name\", collector_type=~\"$collector_type\"}[1m])) by (collector_type)",
          "legendFormat": "Inbound: {{collector_type}}",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "sum(irate(vector_events_out_total{device_name=~\"$device_name\", collector_type=~\"$collector_type\"}[1m])) by (collector_type)",
          "legendFormat": "Outbound: {{collector_type}}",
          "refId": "B"
        , "time": { "from": "now-24h", "to": "now" } }
      ],
      "title": "Fleet-wide Events In/Out Rate",
      "type": "timeseries",
      "fieldConfig": { "defaults": { "unit": "ops" } , "time": { "from": "now-24h", "to": "now" } }
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
