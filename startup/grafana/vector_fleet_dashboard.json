      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(vector_component_errors_total{device_name=~\"$device_name\", collector_type=~\"$collector_type\"}[5m])) by (device_name)",
          "legendFormat": "{{device_name}} errors",
          "refId": "A"
        , "time": { "from": "now-24h", "to": "now" } }
      ],
      "title": "Error Count by Node (Last 5m)",
      "type": "timeseries",
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } } , "time": { "from": "now-24h", "to": "now" } }
