{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Incoming RTB Event Rate (Receivers)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(win_receiver_http_requests_total[5m])) by (machine, handler)", "legendFormat": "{{machine}} - {{handler}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "title": "Vector Ingestion Throughput (Log Collector)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { 
          "expr": "sum(rate(vector_component_received_events_total{collector_type!=''}[5m])) by (machine_id, collector_type)", 
          "legendFormat": "{{machine_id}} - {{collector_type}}" 
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "title": "Vector Sink Health (S3 Write Errors)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 7 },
      "targets": [
        { "expr": "sum(rate(vector_sink_errors_total[5m])) by (machine_id, component_id)", "legendFormat": "S3 Upload Errors" }
      ],
      "fieldConfig": { 
        "defaults": { "unit": "ops", "color": { "mode": "fixed", "fixedColor": "red" } }
      }
    },
    {
      "title": "Processor Database Sync (Reconciler)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 7 },
      "targets": [
        { "expr": "sum(rate(ssp_processor_reconciler_synced_total[5m])) by (machine)", "legendFormat": "DB Sync Rate" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "title": "Log-to-Parquet Performance (Last Run)",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 7 },
      "targets": [
        { "expr": "time() - ssp_log_processor_last_run_timestamp_seconds", "legendFormat": "{{machine}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "max": 3600, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 600 }, { "color": "red", "value": 1800 } ] } }
      }
    },
    {
      "title": "Kafka & DLQ Errors (Critical Pipeline)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "targets": [
        { "expr": "sum(rate(win_receiver_kafka_write_errors_total[5m])) by (machine)", "legendFormat": "Kafka Write Errors" },
        { "expr": "sum(rate(ssp_processor_dlq_messages_total[5m])) by (machine)", "legendFormat": "Processor DLQ Messages" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["RTB", "Cluster", "Observability"],
  "templating": {
    "list": [
      { "name": "machine", "type": "query", "query": "label_values(win_receiver_http_requests_total, machine)", "refresh": 1, "multi": true, "includeAll": true }
    ]
  },
  "title": "SSP Cluster: End-to-End Observability",
  "uid": "ssp-central-cluster-monitoring",
  "version": 4
}
