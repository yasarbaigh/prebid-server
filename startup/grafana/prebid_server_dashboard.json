{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Auction Flow & Vital Signs",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "title": "Auction Request Rate (TPS)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(prebid_rtb_auctions_total[1m])) by (status)", "legendFormat": "{{status}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "title": "SSP Traffic by Partner",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(prebid_rtb_ssp_requests_total[1m])) by (ssp_identifier, ssp_inventory_identifier)", "legendFormat": "{{ssp_identifier}} - {{ssp_inventory_identifier}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "title": "DSP Participation Rate",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(prebid_rtb_dsp_responses_total{status=\"bid\"}[1m])) by (dsp_identifier, dsp_inventory_identifier)", "legendFormat": "{{dsp_identifier}} - {{dsp_inventory_identifier}}" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 5,
      "panels": [],
      "title": "Financial Performance (CPM)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD" }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "id": 6,
      "title": "Exchange Economics (Profit vs Revenue vs Spent)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(prebid_rtb_exchange_profit_total[5m]))", "legendFormat": "Profit" },
        { "expr": "sum(rate(prebid_rtb_exchange_revenue_total[5m]))", "legendFormat": "Revenue (DSP Paid)" },
        { "expr": "sum(rate(prebid_rtb_exchange_spent_total[5m]))", "legendFormat": "Spent (SSP Owed)" }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 34,
  "style": "dark",
  "tags": ["prebid-server", "ad-tech"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "name": "tenant",
        "query": "label_values(prebid_rtb_auctions_total, tenant_identifier)",
        "type": "query",
        "datasource": "${datasource}",
        "refresh": 1
      },
      {
        "name": "ssp_inv",
        "query": "label_values(prebid_rtb_auctions_total, ssp_inventory_identifier)",
        "type": "query",
        "datasource": "${datasource}",
        "refresh": 1
      }
    ]
  },
  "title": "Prebid Server - Global Auction Dashboard",
  "uid": "pbs-auction-v1"
}
