{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Throughput & Efficiency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (device_name, type, status) (rate(win_processor_events_total{device_name=~\"$device_name\", type=~\"$type\"}[1m]))",
          "legendFormat": "{{device_name}} - {{type}} ({{status}})",
          "refId": "A"
        }
      ],
      "title": "Throughput by Device & Status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, device_name, type) (rate(win_processor_batch_duration_seconds_bucket{device_name=~\"$device_name\", type=~\"$type\"}[1m])))",
          "legendFormat": "{{device_name}} {{type}} P99",
          "refId": "A"
        }
      ],
      "title": "Batch Processing Latency",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "panels": [],
      "title": "Main DB Reconciler (Billing)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 5,
      "targets": [
        {
          "expr": "sum by (device_name, status) (rate(win_processor_reconciler_synced_total{device_name=~\"$device_name\"}[5m]))",
          "legendFormat": "{{device_name}} - {{status}}",
          "refId": "A"
        }
      ],
      "title": "Reconciler Sync Rate by Device",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 34,
  "style": "dark",
  "tags": ["win-processor"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(win_processor_events_total, device_name)",
        "hide": 0,
        "includeAll": true,
        "label": "Device",
        "multi": true,
        "name": "device_name",
        "query": "label_values(win_processor_events_total, device_name)",
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(win_processor_events_total, type)",
        "hide": 0,
        "includeAll": true,
        "label": "Event Type",
        "multi": true,
        "name": "type",
        "query": "label_values(win_processor_events_total, type)",
        "refresh": 1,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "title": "Win Processor Advanced Dashboard",
