[Unit]
Description=Prometheus Node Exporter
Wants=network-online.target
After=network-online.target

[Service]
User=node_exporter
Group=node_exporter
Type=simple
Restart=on-failure
RestartSec=5s
ExecStart=/usr/local/bin/node_exporter \
    --collector.systemd \
    --collector.systemd.unit-include="(ssp-.*|prebid-server|mysql|mariadb|kafka|vector|nginx).*(service|timer)"

[Install]
WantedBy=multi-user.target
